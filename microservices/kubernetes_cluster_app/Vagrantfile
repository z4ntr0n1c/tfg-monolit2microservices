Vagrant.configure("2") do |config|
  config.vm.provider :virtualbox do |v|
    v.memory = 2048
    v.cpus = 1
  end

  config.vm.define :master do |master|
    config.vm.boot_timeout = 600
	config.vm.box_download_insecure = true
	#config.ssh.insert_key = false
    master.vm.box = "learnk8s/networking"
    master.vm.box_version = "3.0.0"
    master.vm.hostname = "master"
    master.vm.network :private_network, ip: "10.0.0.10"
    master.vm.provision :shell, privileged: false, inline: $provision_master
    master.vm.provider :virtualbox do |vb|
      vb.cpus = 2
	  vb.name = "master"
    end
  end

  %w{worker1 worker2}.each_with_index do |name, i|
    config.vm.define name do |worker|
	  config.vm.boot_timeout = 600
	  config.vm.box_download_insecure = true
	  #config.ssh.insert_key = false
      worker.vm.box = "learnk8s/networking"
      worker.vm.box_version = "3.0.0"
      worker.vm.hostname = name
      worker.vm.provider :virtualbox do |vb|
        vb.customize ["modifyvm", :id, "--memory", "2048"]
		vb.name = name
      end
      worker.vm.network :private_network, ip: "10.0.0.#{i + 11}"
      worker.vm.provision :shell, privileged: false, inline: <<-SHELL
sudo /vagrant/join.sh
echo 'Environment="KUBELET_EXTRA_ARGS=--node-ip=10.0.0.#{i + 11}"' | \
  sudo tee -a /etc/systemd/system/kubelet.service.d/10-kubeadm.conf
sudo systemctl daemon-reload
sudo systemctl restart kubelet
sudo systemctl enable docker
SHELL
    end
  end

end

$provision_master = <<-SHELL
OUTPUT_FILE=/vagrant/join.sh
rm -rf $OUTPUT_FILE

# Start cluster
sudo kubeadm init \
  --ignore-preflight-errors=SystemVerification \
  --apiserver-advertise-address=10.0.0.10 \
  --pod-network-cidr=10.244.0.0/16 \
  --kubernetes-version v1.20.15 | \
  grep -A1 "kubeadm join" > ${OUTPUT_FILE}
chmod +x $OUTPUT_FILE

# Configure kubectl
mkdir -p $HOME/.kube
sudo cp -i /etc/kubernetes/admin.conf $HOME/.kube/config
sudo chown $(id -u):$(id -g) $HOME/.kube/config
cp $HOME/.kube/config /vagrant
cp /kube/nginx-ingress-v0.44.0.yaml /vagrant
sudo apt-get install bash-completion
echo 'source <(kubectl completion bash)' >>~/.bashrc
# Fix kubelet IP
echo 'Environment="KUBELET_EXTRA_ARGS=--node-ip=10.0.0.10"' | \
  sudo tee -a /etc/systemd/system/kubelet.service.d/10-kubeadm.conf

# Configure flannel
kubectl apply -f /kube/kube-flannel-v0.13.0.yaml

sudo systemctl daemon-reload
sudo systemctl restart kubelet
sudo systemctl enable docker

# Install metrics
kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml
kubectl patch deployment metrics-server -n kube-system \
--patch '{"spec": {"template": {"spec": {"containers": [{"name": "metrics-server", "args": ["--kubelet-insecure-tls", "--metric-resolution=30s"]}]}}}}'
                                   
#Install Kubernetes Dashboard
kubectl apply -f /vagrant/kubernetes-dashboard.yaml
kubectl create serviceaccount kubernetes-dashboard-admin -n kubernetes-dashboard
kubectl create clusterrolebinding kubernetes-dashboard-admin --clusterrole=cluster-admin --serviceaccount=kubernetes-dashboard:kubernetes-dashboard-admin
echo "Write down token for Kubernetes Dashboard:"
kubectl -n kubernetes-dashboard get secret $(kubectl -n kubernetes-dashboard get sa/kubernetes-dashboard-admin -o jsonpath="{.secrets[0].name}") -o go-template="{{.data.token | base64decode}}"
echo

#Install HELM
/vagrant/helm/get_helm.sh

# ── Vault (dev mode) ─────────────────────────────────────────────────────────
helm repo add hashicorp https://helm.releases.hashicorp.com
helm repo update
kubectl create namespace vault
helm install vault hashicorp/vault \
  --namespace vault \
  --set "server.dev.enabled=true" \
  --set "server.dev.devRootToken=root" \
  --set "injector.enabled=true"

# Wait for Vault pod and injector webhook to be ready
kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=vault \
  -n vault --timeout=180s
kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=vault-agent-injector \
  -n vault --timeout=120s

# Enable Kubernetes auth backend
kubectl exec -n vault vault-0 -- vault auth enable kubernetes
kubectl exec -n vault vault-0 -- sh -c 'vault write auth/kubernetes/config \
  kubernetes_host="https://10.0.0.10:6443" \
  kubernetes_ca_cert=@/var/run/secrets/kubernetes.io/serviceaccount/ca.crt \
  token_reviewer_jwt="$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)"'

# Enable KV-v2 secrets engine and seed MediaWiki secrets
kubectl exec -n vault vault-0 -- vault secrets enable -path=secret kv-v2
kubectl exec -n vault vault-0 -- vault kv put secret/mediawiki/mysql \
  root_password="SuprS3cr3tR00TP43440w0rD!" \
  database="wikidb" \
  user="wikiuser" \
  password="W1k1P#4ssw0rd"
kubectl exec -n vault vault-0 -- vault kv put secret/mediawiki/app \
  secret_key="a17ca47abb212640217484aaf33a574f3039f4ceaf30697bc4221b36b5ac8e34" \
  upgrade_key="9ce92dbb5335dff5"

# Create Vault policy for mediawiki (read-only on its own paths)
kubectl exec -n vault vault-0 -- vault policy write mediawiki - <<'VAULTPOLICY'
path "secret/data/mediawiki/*" {
  capabilities = ["read"]
}
VAULTPOLICY

# Bind the mediawiki ServiceAccount to the policy
kubectl exec -n vault vault-0 -- vault write auth/kubernetes/role/mediawiki \
  bound_service_account_names=mediawiki-sa \
  bound_service_account_namespaces=mediawiki \
  policies=mediawiki \
  ttl=1h

echo "==> Vault dev-mode ready. UI: kubectl port-forward -n vault svc/vault 8200:8200 (token: root)"
# ─────────────────────────────────────────────────────────────────────────────

#Install MediaWiki
helm install mediawiki /vagrant/helm/mediawiki --create-namespace --namespace mediawiki

SHELL
